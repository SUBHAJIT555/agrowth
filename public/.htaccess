Options -Indexes -MultiViews +FollowSymLinks
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule (^|/)\.env$ - [F,L]
  RewriteRule (^|/)mpurse\.env$ - [F,L]
  RewriteRule ^api/data/ - [F,L]

  RewriteRule ^api/submit/?$ api/submit.php [L]
  RewriteRule ^api/mpurse/?$ api/mpurse.php [L]
  RewriteRule ^api/mpurse-webhook/?$ api/mpurse-webhook.php [L]
  RewriteRule ^mail\.php$ api/submit.php [L]

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1$
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteRule ^checkout/?$ checkout.html [L]
  RewriteRule ^pay/?$ pay.html [L]
  RewriteRule ^order-status/?$ order-status.html [L]
  RewriteRule ^checkout/payment/?$ checkout/payment.html [L]
  RewriteRule ^checkout/success/?$ checkout/success.html [L]

  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{DOCUMENT_ROOT}/$1 -d
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L,QSA]

  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L,QSA]
</IfModule>

<FilesMatch "^\.env">
  Require all denied
</FilesMatch>
